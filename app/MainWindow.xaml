<ui:FluentWindow x:Class="BitLockerLock.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:BitLockerLock"
                 Title="Re-Lock BitLocker"
                 Width="540" Height="620" MinWidth="420" MinHeight="400"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static local:Strings.AppTitle}" />

        <Grid Grid.Row="1" Margin="28,12,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static local:Strings.Heading}"
                               FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static local:Strings.Subtitle}"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button x:Name="RefreshButton"
                               Content="{x:Static local:Strings.Refresh}"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Click="RefreshButton_Click" />
                    <ui:Button x:Name="LockAllButton"
                               Margin="8,0,0,0"
                               Content="{x:Static local:Strings.LockAll}"
                               Icon="{ui:SymbolIcon LockClosed24}"
                               Appearance="Primary"
                               IsEnabled="False"
                               Click="LockAllButton_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl x:Name="DriveList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="16" BorderThickness="1" CornerRadius="8"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}"
                                                       FontSize="28" Margin="0,0,16,0"
                                                       VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Status}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <ui:Button Grid.Column="2" VerticalAlignment="Center"
                                                   Content="{x:Static local:Strings.Lock}"
                                                   Icon="{ui:SymbolIcon LockClosed24}"
                                                   Appearance="Primary"
                                                   IsEnabled="{Binding CanLock}"
                                                   Visibility="{Binding ShowButton, Converter={StaticResource B2V}}"
                                                   Click="LockButton_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                HorizontalAlignment="Center" Margin="0,60,0,0">
                        <ui:SymbolIcon Symbol="HardDrive24" FontSize="48"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Static local:Strings.EmptyTitle}" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="{x:Static local:Strings.EmptyHint}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="28,8,28,16" MinHeight="20"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
</ui:FluentWindow>
